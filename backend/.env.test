# Integration-test env. medusaIntegrationTestRunner creates a throwaway
# database per suite using DB_USERNAME/DB_PASSWORD/DB_HOST (pg-god).
# DB_USERNAME defaults to the OS user in jest.config.js (Homebrew
# Postgres); set DB_USERNAME=postgres in CI. DATABASE_URL is a
# placeholder that satisfies lib/constants only.
NODE_ENV=test
DB_HOST=localhost
DATABASE_URL=postgres://localhost/medusa-test-placeholder
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
# Force in-memory event bus / workflow engine: loadEnv also reads .env,
# and an empty value here wins over the REDIS_URL defined there.
REDIS_URL=
